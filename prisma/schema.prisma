// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String    @id @default(cuid())
  username              String    @unique
  passwordHash          String
  createdAt             DateTime  @default(now())
  sessions              Session[]
  name                  String?
  englishLevel          String?
  strongAreas           String[]
  weakAreas             String[]
  onboardingCompleted   Boolean   @default(false)
  frownBase             Float?
  frownMax              Float?
  smileMax              Float?
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  score        Int
  focusLevel   Float
  hintsUsed    Int
  finalEmotion String
  createdAt    DateTime @default(now())
}